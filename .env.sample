# The ports of the editor.
#
# The project has a port of its own for the local work, so the editor does not collide with the other
# projects of the machine. Both values are read through dotenv, by the vite config and by the Playwright
# setup, and the defaults written in those configs are the same numbers: a clone without a `.env` works.
#
# Copy this file to `.env` to change them. `.env` is not committed, this file is its documentation.
#
# Keep the numbers out of the blocked ports of the browsers: firefox refuses a request to some of them
# (`6000` among them, with "this address is restricted"), so a port like that never serves the editor in
# firefox. The two below are measured to work there.

# The port the development server (`npm run dev`) serves the editor on: http://127.0.0.1:5000/editor/
# The server runs with `strictPort`, so a taken port fails instead of silently moving to another one.
DEV_PORT=5000

# The port the browser tests (`npm run test:e2e`) start their own development server on. It is a separate
# server on purpose: a hot reload of the developer's server must not change the page under a test.
E2E_PORT=5001
