{
  "name": "arx-fatalis-browser-editor",
  "version": "0.0.2",
  "description": "A browser based editor for Arx Fatalis levels",
  "engines": {
    "npm": ">=8.0.0",
    "node": ">=18.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "xo",
    "lint:watch": "nodemon --watch src --exec \"npm run lint\" --ext ts",
    "test": "ts-mocha --import=@hyperse/ts-node/register src/**/*.spec.ts",
    "test:watch": "nodemon --watch src --exec \"npm run test\" --ext ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arx-tools/arx-fatalis-browser-editor.git"
  },
  "author": "Lajos Meszaros <m_lajos@hotmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/arx-tools/arx-fatalis-browser-editor/issues"
  },
  "homepage": "https://github.com/arx-tools/arx-fatalis-browser-editor#readme",
  "dependencies": {
    "arx-convert": "^13.0.0",
    "arx-header-size": "^3.2.1",
    "color-rgba": "^3.0.0",
    "jszip": "^3.10.1",
    "node-pkware": "^5.9.1",
    "sass-embedded": "^1.100.0",
    "three": "^0.183.1",
    "three-mesh-bvh": "^0.9.9",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@hyperse/ts-node": "^1.1.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/color-rgba": "^2.1.3",
    "@types/expect": "^24.3.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.12.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "expect": "^30.3.0",
    "http-server": "^14.1.1",
    "mocha": "^11.7.5",
    "ts-mocha": "^11.1.0",
    "type-fest": "^5.5.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-tsconfig-paths": "^6.1.1",
    "vue-tsc": "^3.2.8",
    "xo": "^2.0.2"
  },
  "keywords": [
    "arx-fatalis"
  ]
}
