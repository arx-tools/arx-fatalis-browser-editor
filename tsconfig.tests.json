{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    // the tests run through node's type stripping and the built-in test runner, they need the node
    // globals (`node:test`, `Buffer`) and they are never emitted
    "types": ["node"],
    "noEmit": true,
    "incremental": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    // type stripping only accepts erasable syntax, so the tests can not use enums or namespaces
    "erasableSyntaxOnly": true
  },
  // the tests import the sources, and a source that reads a build time constant (`EDITOR_INFO`, `BUILD_INFO`) needs the
  // declaration of that constant: the ambient files of the app are included for the modules the tests pull in
  "include": ["tests/**/*", "src/**/*.d.ts"]
}
